# 运行环境基础镜像：把浏览器依赖、字体、Xvfb 一次性装进镜像
#
# 为什么需要这个文件：
#   1Panel「Node 运行环境」重启时是**按镜像重建容器**，
#   apt 装的东西在容器层里 —— 容器一重建就全没了，
#   于是每次重启都要重新 apt install fonts / libnss3 / xvfb（1-3 分钟）。
#   只有挂载出来的目录（项目目录 .pw-browsers）是持久的。
#
#   把依赖烘进镜像后，重启就是秒起，entry 脚本里的安装分支全部走 "已就绪"。
#
# 构建（在服务器上，项目目录内）：
#   bash deploy/build-runtime-image.sh
#
# 然后在 1Panel 的运行环境里，把镜像指向 douyin-monitor-runtime:1.2.19
# （代码仍然挂载项目目录，镜像只提供系统依赖）。

FROM node:22-bookworm-slim

ENV DEBIAN_FRONTEND=noninteractive \
    TZ=Asia/Shanghai \
    PLAYWRIGHT_BROWSERS_PATH=/app/.pw-browsers

# ---------------------------------------------------------------------------
# 1) 系统依赖：
#    - chromium 依赖（libnss3 / libgbm / libasound2 ...）
#    - Xvfb（扫码登录有头模式需要虚拟屏）
#    - 字体：noto-cjk 覆盖日常中文；hanazono 覆盖 CJK 扩展区生僻字
# ---------------------------------------------------------------------------
RUN apt-get update -qq \
 && apt-get install -y -qq --no-install-recommends \
      ca-certificates curl unzip tini \
      xvfb xauth \
      fonts-noto-cjk fonts-noto-color-emoji fonts-hanazono \
      libnss3 libnspr4 libatk1.0-0 libatk-bridge2.0-0 libatspi2.0-0 \
      libcups2 libdbus-1-3 libdrm2 libxkbcommon0 libxcomposite1 libxdamage1 \
      libxext6 libxfixes3 libxrandr2 libgbm1 libpango-1.0-0 libcairo2 \
      libasound2 libx11-6 libx11-xcb1 libxcb1 libxcb-dri3-0 libxshmfence1 \
 && fc-cache -f >/dev/null 2>&1 || true \
 && rm -rf /var/lib/apt/lists/*

# ---------------------------------------------------------------------------
# 2) Playwright 的浏览器下载到 /app/.pw-browsers
#    真实部署时这个目录会被项目目录挂载覆盖（持久化），
#    所以这里不预装 chromium，只保证"系统库齐了"，chromium 由 entry 脚本下到挂载盘。
# ---------------------------------------------------------------------------
WORKDIR /app

# 让 entry 脚本能直接判断"依赖已就绪"，不必再走 apt 分支
ENV DY_RUNTIME_IMAGE=1

ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["bash", "/app/deploy/container-entry.sh"]
