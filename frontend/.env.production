# 【生产】环境变量

# 应用版本号（改版本号会让升级检测触发一次：清理旧版本的本地存储键）
# 见 .env.development 里的说明：不定义会让 __APP_VERSION__ 变成字面值 undefined
VITE_VERSION = 1.1.0

# 应用部署基础路径（如部署在子目录 /admin，则设置为 /admin/）
VITE_BASE_URL = /

# 权限/菜单来源模式（frontend=用前端路由配置；本项目后端没有 /api/v3/system/menus）
VITE_ACCESS_MODE = frontend

# API 地址前缀
#
# 必须是 '/'：本站后端和前端同源（web-dashboard.js 同时托管 dist 和 /api）。
# 原来这里是模板自带的 apifox mock 地址（https://m1.apifoxmock.com/...），
# 任何走 '@utils/http' 的请求都会打到那个 mock 站：
#   · 返回 401「无效令牌」→ 前端按会话过期处理，直接把用户登出
#   · 即便不 401，拿到的也是假数据
# 用户反馈的"刚登录就说无效令牌"就是它引起的（系统管理三页当时用了那个 http）。
VITE_API_URL = /

# Delete console
VITE_DROP_CONSOLE = true